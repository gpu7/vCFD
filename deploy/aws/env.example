# Copy to /etc/vcfd/vcfd.env on the instance (never commit real secrets).
# launch-ec2.sh can generate a random VCFD_AUTH_TOKEN for you.

# --- MCP / OpenFOAM ---
VCFD_CASES_ROOT=/data/vcfd/cases
VCFD_TEMPLATES_ROOT=/opt/vcfd/cases/templates
VCFD_JOBS_ROOT=/data/vcfd/jobs
VCFD_OPENFOAM_MODE=docker
VCFD_OPENFOAM_DOCKER_IMAGE=opencfd/openfoam-default:2506
VCFD_TRANSPORT=http
VCFD_HOST=0.0.0.0
VCFD_PORT=8000
VCFD_MAX_CONCURRENT_JOBS=2
VCFD_DEFAULT_JOB_TIMEOUT_SEC=3600

# Required for remote Grok Voice MCP. Long random string.
VCFD_AUTH_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Optional: public hostname for Caddy automatic HTTPS (Let's Encrypt).
# If empty, Caddy serves HTTP only on :80 (fine for first bring-up / IP-only tests).
VCFD_DOMAIN=

# Optional email for Let's Encrypt (recommended when VCFD_DOMAIN is set)
VCFD_ACME_EMAIL=

# Git ref to deploy
VCFD_GIT_URL=https://github.com/gpu7/vCFD.git
VCFD_GIT_REF=master
