# Cases root (absolute or relative to cwd)
VCFD_CASES_ROOT=./cases/workspace

# Templates directory
VCFD_TEMPLATES_ROOT=./cases/templates

# Jobs state directory
VCFD_JOBS_ROOT=./.vcfd/jobs

# OpenFOAM mode: mock | docker | native
VCFD_OPENFOAM_MODE=mock

# Docker image when mode=docker
VCFD_OPENFOAM_DOCKER_IMAGE=opencfd/openfoam-default:2506

# Bearer token required for HTTP transport (leave empty to disable auth in local dev only)
VCFD_AUTH_TOKEN=

# HTTP server bind (remote MCP)
VCFD_HOST=0.0.0.0
VCFD_PORT=8000

# Resource limits
VCFD_MAX_CONCURRENT_JOBS=2
VCFD_DEFAULT_JOB_TIMEOUT_SEC=3600
